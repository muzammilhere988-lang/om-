# =========================================================
# OM – OPEN MARKET | Environment Variables Configuration
# =========================================================
# Copy this file to .env (local development) or configure
# these variables in your Hostinger hosting environment.
# NEVER commit your real .env file to GitHub.

# --- Supabase Frontend Configuration (Safe for Browser) ---
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# --- Supabase Server Configuration (Server-Side ONLY) ---
# WARNING: NEVER prefix SUPABASE_SERVICE_ROLE_KEY with VITE_!
# It must only exist on the server (server.ts / Hostinger Node env).
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- Application Runtime Configuration ---
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
